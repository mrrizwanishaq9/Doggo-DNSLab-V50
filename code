def cli_mode(args):

    if args.cli_help:

        show_cli_help()

        return True

    if args.reverse:

        reverse_name = None

        try:

            address = ipaddress.ip_address(
                args.reverse
            )

            reverse_name = (
                address.reverse_pointer
            )

        except ValueError:

            print(
                "Invalid IP address."
            )

            return True

        result = resolve_dns(
            reverse_name,
            "PTR",
            nameserver=args.resolver,
            use_cache=False,
        )

        if args.json:

            print(
                json.dumps(
                    result,
                    indent=2,
                    ensure_ascii=False,
                )
            )

        else:

            print_result(result)

        return True

    if args.health:

        if not args.domain:

            print(
                "--health requires --domain"
            )

            return True

        domain = clean_domain(
            args.domain
        )

        for record in [
            "A",
            "AAAA",
            "MX",
            "NS",
            "SOA",
            "TXT",
        ]:

            result = resolve_dns(
                domain,
                record,
                nameserver=args.resolver,
                use_cache=False,
            )

            if args.json:

                print(
                    json.dumps(
                        result,
                        ensure_ascii=False,
                    )
                )

            else:

                print(
                    f"{record:<6}"
                    f"{'OK' if result.get('ok') else 'FAIL':<7}"
                    f"{result.get('response_ms','-')} ms"
                )

        return True

    if args.compare:

        if not args.domain:

            print(
                "--compare requires --domain"
            )

            return True

        domain = clean_domain(
            args.domain
        )

        results = []

        for name, resolver in RESOLVERS.items():

            result = resolver_test(
                resolver,
                domain,
                args.type.upper(),
            )

            result["name"] = name

            results.append(result)

        if args.json:

            print(
                json.dumps(
                    results,
                    indent=2,
                )
            )

        else:

            for result in results:

                print(
                    f"{result['name']:<12}"
                    f"{'OK' if result['ok'] else 'FAIL':<7}"
                    f"{result['ms']} ms"
                )

        return True

    if args.domain:

        domain = clean_domain(
            args.domain
        )

        record = (
            args.type
            or "A"
        ).upper()

        if args.doh:

            result = doh_query(
                domain,
                record,
            )

        else:

            result = resolve_dns(
                domain,
                record,
                nameserver=args.resolver,
                use_cache=not args.no_cache,
            )

        if args.json:

            print(
                json.dumps(
                    result,
                    indent=2,
                    ensure_ascii=False,
                )
            )

        else:

            print_result(result)

        return True

    return False


