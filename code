def dot_probe():

    host = input(
        "DoT host [cloudflare-dns.com]: "
    ).strip()

    if not host:
        host = "cloudflare-dns.com"

    print(
        "\nConnecting to DNS-over-TLS..."
    )

    started = time.perf_counter()

    try:

        context = ssl.create_default_context()

        with socket.create_connection(
            (
                host,
                853,
            ),
            timeout=float(
                CONFIG["timeout"]
            ),
        ) as raw_socket:

            with context.wrap_socket(
                raw_socket,
                server_hostname=host,
            ) as tls:

                elapsed = (
                    time.perf_counter()
                    - started
                ) * 1000

                print(
                    paint(
                        "✓ DoT TLS connection established",
                        "green",
                    )
                )

                print(
                    f"Host       : {host}:853"
                )

                print(
                    f"TLS        : "
                    f"{tls.version()}"
                )

                cipher = tls.cipher()

                print(
                    f"Cipher     : "
                    f"{cipher[0] if cipher else '-'}"
                )

                print(
                    f"Time       : "
                    f"{elapsed:.2f} ms"
                )

                print(
                    "\nNote: this menu performs a TLS "
                    "connectivity probe."
                )

    except Exception as e:

        print(
            paint(
                f"✗ DoT probe failed: {e}",
                "red",
            )
        )


