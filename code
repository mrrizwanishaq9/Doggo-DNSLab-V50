        if valid:
            return normalized

        print(
            paint(
                f"Invalid domain: {normalized}",
                "red",
            )
        )


def record_query():

    print(
        "\nAvailable records:"
    )

    print(
        ", ".join(RECORD_TYPES)
    )

    record = input(
        "Record type: "
    ).strip().upper()

    if not record:
        record = "A"

    if record == "PTR":

        ip = input(
            "IPv4/IPv6 address: "
        ).strip()

        reverse_lookup(ip)

        return

    if record not in RECORD_TYPES:

        if not re.match(
            r"^[A-Z0-9-]{1,15}$",
            record,
        ):

            print(
                paint(
                    "Invalid DNS record type.",
                    "red",
                )
            )

            return

    domain = ask_domain()

    result = resolve_dns(
        domain,
        record,
    )

    print_result(result)


def reverse_lookup(ip):

    try:
        address = ipaddress.ip_address(
            ip.strip()
        )

        reverse_name = address.reverse_pointer

    except ValueError:

        print(
            paint(
                "Invalid IP address.",
                "red",
            )
        )

        return

    print(
        f"\nReverse DNS name: {reverse_name}"
    )

    result = resolve_dns(
        reverse_name,
        "PTR",
        use_cache=False,
    )

    print_result(result)


def resolver_test(
    resolver,
    domain,
    record="A",
):

    result = resolve_dns(
        domain,
        record,
        nameserver=resolver,
        use_cache=False,
    )

    return {
        "ok": result.get("ok", False),
        "resolver": resolver,
        "ms": result.get(
            "response_ms"
        ),
        "answers": len(
            result.get(
                "answers",
                [],
            )
        ),
        "error": result.get(
            "error",
            "",
        ),
    }


def resolver_comparison():

    domain = ask_domain()

    print(
        paint(
            f"\nResolver comparison: {domain}\n",
            "cyan",
        )
    )

    results = []

    for name, resolver in RESOLVERS.items():

        print(
            f"Testing {name} "
            f"({resolver})..."
        )

        result = resolver_test(
            resolver,
            domain,
        )

        result["name"] = name

        results.append(result)

    custom = input(
        "\nCustom resolver IP "
        "(Enter to skip): "
    ).strip()

    if custom:

        try:

            ipaddress.ip_address(
                custom
            )

            result = resolver_test(
                custom,
                domain,
            )

            result["name"] = "Custom"

            results.append(result)

        except ValueError:

            print(
                paint(
                    "Invalid resolver IP.",
                    "red",
                )
            )

    print()
    print(
        "Resolver        Status      Time        Answers"
    )
    print(
        "-" * 58
    )

    for result in results:

        status = (
            "OK"
            if result["ok"]
            else "FAIL"
        )

        ms = result["ms"]

        if isinstance(
            ms,
            (int, float),
        ):
            ms_text = f"{ms:.2f} ms"
        else:
            ms_text = "-"

        print(
            f"{result['name']:<15}"
            f"{status:<12}"
            f"{ms_text:<12}"
            f"{result['answers']}"
        )

    print(
        "\nThis is a local network-path comparison,"
        " not a global resolver ranking."
    )


def response_time_test():

    domain = ask_domain()

    record = input(
        "Record [A]: "
    ).strip().upper() or "A"

    try:
        samples = int(
            input(
                "Samples [5]: "
            ).strip() or "5"
        )

    except ValueError:
        samples = 5

    samples = max(
        1,
        min(
            samples,
            30,
        ),
    )

    times = []

    print()

    for number in range(
        1,
        samples + 1,
    ):

        result = resolve_dns(
            domain,
            record,
            use_cache=False,
        )

        if result.get("ok"):

            ms = result["response_ms"]

            times.append(ms)

            print(
                f"Sample {number:02d}: "
                f"{ms} ms"
            )

        else:

            print(
                f"Sample {number:02d}: "
                f"FAIL"
            )

    if not times:
        print(
            paint(
                "\nNo successful samples.",
                "red",
            )
        )
        return

    print()
    print(
        f"Minimum : {min(times):.2f} ms"
    )

    print(
        f"Average : {statistics.mean(times):.2f} ms"
    )

    print(
        f"Maximum : {max(times):.2f} ms"
    )

    if len(times) > 1:
        print(
            f"Median  : {statistics.median(times):.2f} ms"
        )


def health_check():

    domain = ask_domain()

    checks = [
        "A",
        "AAAA",
        "CNAME",
        "MX",
        "NS",
        "TXT",
        "SOA",
        "CAA",
    ]

    print(
        paint(
            f"\nDNS HEALTH CHECK: {domain}",
            "cyan",
        )
    )

    success = 0

    for record in checks:

        result = resolve_dns(
            domain,
            record,
            use_cache=False,
        )

        if result.get("ok"):

            success += 1

            print(
                paint(
                    f" ✓ {record:<6} "
                    f"{len(result.get('answers', []))} "
                    f"answer(s) "
                    f"{result.get('response_ms')} ms",
                    "green",
                )
            )

        else:

            print(
                f" • {record:<6} "
                f"no answer / "
                f"{str(result.get('error'))[:50]}"
            )

    print()
    print(
        f"Responsive checks: "
        f"{success}/{len(checks)}"
    )

    print(
        "A missing optional DNS record does not"
        " automatically mean the DNS is unhealthy."
    )


def propagation_check():

    domain = ask_domain()

    record = input(
        "Record [A]: "
    ).strip().upper() or "A"

    results = []

    print(
        paint(
            f"\nDNS propagation comparison"
            f"\nDomain: {domain}"
            f"\nRecord: {record}\n",
            "cyan",
        )
    )

    for name, resolver in RESOLVERS.items():

        result = resolve_dns(
            domain,
            record,
            nameserver=resolver,
            use_cache=False,
        )

        results.append(
            (
                name,
                result,
            )
        )

        values = [
            str(x.get("value"))
            for x in result.get(
                "answers",
                [],
            )
        ]

        print(
            f"{name} ({resolver})"
        )

        print(
            f"  Status: "
            f"{'OK' if result.get('ok') else 'FAIL'}"
        )

        print(
            f"  Time  : "
            f"{result.get('response_ms', '-')}"
            f" ms"
        )

        print(
            f"  Value : "
            f"{', '.join(values) if values else '-'}"
        )

    value_sets = []

    for _, result in results:

        if result.get("ok"):

            values = tuple(
                sorted(
                    str(x.get("value"))
                    for x in result.get(
                        "answers",
                        [],
                    )
                )
            )

            value_sets.append(values)

    if value_sets:

        if len(set(value_sets)) == 1:

            print(
                paint(
                    "\nAll tested resolvers returned "
                    "the same answer set.",
                    "green",
                )
            )

        else:

            print(
                paint(
                    "\nResolvers returned different "
                    "answer sets.",
                    "yellow",
                )
            )

            print(
                "Possible causes include TTL/cache timing,"
                " geographic DNS behavior, or configuration."
            )


def batch_domains():

    filename = input(
        "Input file (.txt/.csv): "
    ).strip().strip('"')

    path = Path(filename)

    if not path.exists():

        print(
            paint(
                "File not found.",
                "red",
            )
        )

        return

    domains = []

    try:

        if path.suffix.lower() == ".csv":

            with open(
                path,
                "r",
                encoding="utf-8-sig",
                newline="",
            ) as f:

                reader = csv.reader(f)

                for row in reader:

                    if row and row[0].strip():

                        domains.append(
                            row[0].strip()
                        )

        else:

            with open(
                path,
                "r",
                encoding="utf-8",
            ) as f:

                for line in f:

                    line = line.strip()

                    if (
                        line
                        and not line.startswith("#")
                    ):
                        domains.append(line)

    except Exception as e:

        print(
            paint(
                f"File error: {e}",
                "red",
            )
        )

        return

    domains = domains[:500]

    record = input(
        "Record [A]: "
    ).strip().upper() or "A"

    output = Path(
        "doggo_batch_results.csv"
    )

    rows = []

    print()

    for domain in domains:

        result = resolve_dns(
            domain,
            record,
            use_cache=False,
        )

        status = (
            "OK"
            if result.get("ok")
            else "FAIL"
        )

        print(
            f"{domain:<40}"
            f"{status:<7}"
            f"{result.get('response_ms', '-')}"
            f" ms"
        )

        rows.append({
            "domain": domain,
            "record": record,
            "status": status,
            "response_ms": result.get(
                "response_ms"
            ),
            "answers": len(
                result.get(
                    "answers",
                    [],
                )
            ),
            "error": result.get(
                "error",
                "",
            ),
        })

    with open(
        output,
        "w",
        newline="",
        encoding="utf-8",
    ) as f:

        writer = csv.DictWriter(
            f,
            fieldnames=[
                "domain",
                "record",
                "status",
                "response_ms",
                "answers",
                "error",
            ],
        )

        writer.writeheader()
        writer.writerows(rows)

    print(
        paint(
            f"\nSaved: {output.resolve()}",
            "green",
        )
    )


