def make_resolver(dns_lib, nameserver):
    resolver = dns_lib["resolver"].Resolver(configure=False)

    resolver.nameservers = [nameserver]

    resolver.timeout = float(CONFIG["timeout"])

    resolver.lifetime = (
        float(CONFIG["timeout"])
        * max(1, int(CONFIG["retries"]))
    )

    return resolver


def cache_key(domain, record, resolver, protocol):
    return (
        f"{domain.lower()}|"
        f"{record.upper()}|"
        f"{resolver}|"
        f"{protocol}"
    )


def cache_get(key):

    item = CACHE.get(key)

    if not item:
        return None

    try:
        age = time.time() - float(item["time"])

        if age <= float(CONFIG["cache_ttl"]):
            return item["data"]

    except Exception:
        pass

    CACHE.pop(key, None)

    return None


def cache_put(key, data):

    CACHE[key] = {
        "time": time.time(),
        "data": data,
    }

    if len(CACHE) > 1000:

        keys = sorted(
            CACHE,
            key=lambda x: CACHE[x].get("time", 0),
        )

        for key in keys[:100]:
            CACHE.pop(key, None)


def rdata_text(rdata):

    try:
        return rdata.to_text().strip()
    except Exception:
        return str(rdata).strip()


def rdata_to_dict(rdata, record_type):

    text = rdata_text(rdata)

    item = {
        "type": record_type,
        "value": text,
    }

    if record_type in ("A", "AAAA"):

        if hasattr(rdata, "address"):
            item["address"] = rdata.address

    elif record_type in ("CNAME", "NS", "PTR"):

        attr = {
            "CNAME": "target",
            "NS": "target",
            "PTR": "target",
        }[record_type]

        if hasattr(rdata, attr):
            item[attr] = str(
                getattr(rdata, attr)
            ).rstrip(".")

    elif record_type == "MX":

        if hasattr(rdata, "preference"):
            item["preference"] = int(
                rdata.preference
            )

        if hasattr(rdata, "exchange"):
            item["exchange"] = str(
                rdata.exchange
            ).rstrip(".")

    elif record_type == "SRV":

        for attr in [
            "priority",
            "weight",
            "port",
            "target",
        ]:

            if hasattr(rdata, attr):

                value = getattr(rdata, attr)

                if attr == "target":
                    value = str(value).rstrip(".")

                else:
                    value = int(value)

                item[attr] = value

    elif record_type == "SOA":

        for attr in [
            "mname",
            "rname",
            "serial",
            "refresh",
            "retry",
            "expire",
            "minimum",
        ]:

            if hasattr(rdata, attr):

                value = getattr(rdata, attr)

                if attr in ("mname", "rname"):
                    value = str(value).rstrip(".")
                else:
                    value = int(value)

                item[attr] = value

    return item


def add_history(result):

    HISTORY.append({
        "time": timestamp(),
        "domain": result.get("domain"),
        "record": result.get("record"),
        "resolver": result.get("resolver"),
        "protocol": CONFIG.get("protocol"),
        "ok": result.get("ok"),
        "response_ms": result.get("response_ms"),
        "answers": len(result.get("answers", [])),
        "error": result.get("error", ""),
    })

    save_state()


def resolve_dns(
    domain,
    record_type,
    nameserver=None,
    use_cache=True,
):

    dns_lib = require_dns()

    if not dns_lib:
        return {
            "ok": False,
            "error": "dnspython is not installed",
        }

    domain = clean_domain(domain)

    valid, normalized = validate_domain(domain)

    if not valid:
        return {
            "ok": False,
            "domain": domain,
            "record": record_type,
            "error": normalized,
        }

    domain = normalized

    nameserver = (
        nameserver
        or CONFIG["resolver"]
    )

    protocol = CONFIG["protocol"]

    key = cache_key(
        domain,
        record_type,
        nameserver,
        protocol,
    )

    if use_cache:

        cached = cache_get(key)

        if cached is not None:

            result = {
                "ok": True,
                "domain": domain,
                "record": record_type,
                "resolver": nameserver,
                "cached": True,
                **cached,
            }

            return result

    started = time.perf_counter()

    last_error = ""

    for attempt in range(
        max(1, int(CONFIG["retries"]))
    ):

        try:

            resolver = make_resolver(
                dns_lib,
                nameserver,
            )

            if protocol == "tcp":

                answer = resolver.resolve(
                    domain,
                    record_type,
                    tcp=True,
                )

            else:

                answer = resolver.resolve(
                    domain,
                    record_type,
                    tcp=False,
                )

            answers = []

            for rr in answer:
                answers.append(
                    rdata_to_dict(
                        rr,
                        record_type,
                    )
                )

            elapsed = (
                time.perf_counter()
                - started
            ) * 1000

            ttl = None

            try:
                ttl = answer.rrset.ttl
            except Exception:
                pass

            data = {
                "answers": answers,
                "ttl": ttl,
                "response_ms": round(
                    elapsed,
                    2,
                ),
                "attempts": attempt + 1,
                "cached": False,
            }

            cache_put(
                key,
                data,
            )

            result = {
                "ok": True,
                "domain": domain,
                "record": record_type,
                "resolver": nameserver,
                **data,
            }

            add_history(result)

            return result

        except Exception as e:

            last_error = str(e)

            if CONFIG.get("debug"):
                print(
                    paint(
                        f"[DEBUG] Attempt {attempt + 1}: {e}",
                        "red",
                    )
                )

    elapsed = (
        time.perf_counter()
        - started
    ) * 1000

    result = {
        "ok": False,
        "domain": domain,
        "record": record_type,
        "resolver": nameserver,
        "response_ms": round(
            elapsed,
            2,
        ),
        "attempts": CONFIG["retries"],
        "answers": [],
        "error": last_error,
    }

    add_history(result)

    return result


def print_result(result):

    print()

    if not result.get("ok"):

        print(
            paint(
                "✗ DNS QUERY FAILED",
                "red",
            )
        )

        print(
            "Error:",
            result.get(
                "error",
                "Unknown error",
            ),
        )

        return

    print(
        paint(
            "✓ DNS QUERY SUCCESSFUL",
            "green",
        )
    )

    print(
        f"Domain   : {result.get('domain')}"
    )

    print(
        f"Record   : {result.get('record')}"
    )

    print(
        f"Resolver : {result.get('resolver')}"
    )

    print(
        f"Protocol : {CONFIG.get('protocol')}"
    )

    print(
        f"Time     : {result.get('response_ms')} ms"
    )

    print(
        f"Cached   : "
        f"{'YES' if result.get('cached') else 'NO'}"
    )

    print(
        f"Answers  : "
        f"{len(result.get('answers', []))}"
    )

    if result.get("ttl") is not None:
        print(
            f"TTL      : {result['ttl']}"
        )

    print()

    for index, answer in enumerate(
        result.get("answers", []),
        1,
    ):

        print(
            f"  [{index:02d}] "
            f"{answer.get('value', '')}"
        )


