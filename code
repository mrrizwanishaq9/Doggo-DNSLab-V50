                    "Invalid resolver IP. "
                    "Using configured resolver.",
                    "yellow",
                )
            )

    if cli_mode(args):

        save_state()

        return

    banner()

    print(
        f"Python : "
        f"{sys.version.split()[0]}"
    )

    print(
        f"Config : "
        f"{CONFIG_FILE}"
    )

    try:

        import dns

        print(
            paint(
                "dnspython: INSTALLED",
                "green",
            )
        )

    except ImportError:

        print(
            paint(
                "dnspython: NOT INSTALLED",
                "yellow",
            )
        )

        print(
            "Install:"
        )

        print(
            "python -m pip install dnspython"
        )

    print()

    main_menu()


if __name__ == "__main__":
    main()
