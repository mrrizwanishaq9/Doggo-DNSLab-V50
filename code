def clean_domain(domain):
    domain = str(domain).strip()

    if "://" in domain:
        domain = domain.split("://", 1)[1]

    domain = domain.split("/", 1)[0]
    domain = domain.split("?", 1)[0]
    domain = domain.split("#", 1)[0]

    return domain.rstrip(".").lower()


def validate_domain(domain):
    domain = clean_domain(domain)

    if not domain:
        return False, "Empty domain"

    if len(domain) > 253:
        return False, "Domain is longer than 253 characters"

    try:
        ipaddress.ip_address(domain)
        return False, "IP address detected instead of domain"
    except ValueError:
        pass

    try:
        ascii_domain = domain.encode("idna").decode("ascii")
    except Exception as e:
        return False, f"IDN conversion failed: {e}"

    labels = ascii_domain.split(".")

    if any(not label for label in labels):
        return False, "Empty DNS label"

    for label in labels:

        if len(label) > 63:
            return False, "DNS label is longer than 63 characters"

        if not re.match(
            r"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$",
            label,
        ):
            return False, f"Invalid label: {label}"

    return True, ascii_domain


def to_punycode(domain):
    try:
        return clean_domain(domain).encode("idna").decode("ascii")
    except Exception:
        return clean_domain(domain)


def from_punycode(domain):
    try:
        return clean_domain(domain).encode("ascii").decode("idna")
    except Exception:
        return clean_domain(domain)


