def doh_query(domain, record="A"):

    try:
        import requests
    except ImportError:

        return {
            "ok": False,
            "error": (
                "requests is not installed. "
                "Run: python -m pip install requests"
            ),
        }

    domain = clean_domain(domain)

    valid, normalized = validate_domain(
        domain
    )

    if not valid:

        return {
            "ok": False,
            "error": normalized,
        }

    url = (
        "https://cloudflare-dns.com/dns-query"
    )

    started = time.perf_counter()

    try:

        response = requests.get(
            url,
            params={
                "name": normalized,
                "type": record,
            },
            headers={
                "accept":
                    "application/dns-json",
            },
            timeout=float(
                CONFIG["timeout"]
            ),
        )

        elapsed = (
            time.perf_counter()
            - started
        ) * 1000

        data = response.json()

        answers = []

        for answer in (
            data.get("Answer", [])
            or []
        ):

            answers.append({
                "type": answer.get("type"),
                "name": answer.get("name"),
                "value": answer.get("data"),
                "ttl": answer.get("TTL"),
            })

        return {
            "ok": (
                response.ok
                and data.get("Status") == 0
            ),
            "domain": normalized,
            "record": record,
            "resolver": "Cloudflare DoH",
            "response_ms": round(
                elapsed,
                2,
            ),
            "answers": answers,
            "dns_status": data.get(
                "Status"
            ),
            "error": (
                ""
                if response.ok
                else f"HTTP {response.status_code}"
            ),
        }

    except Exception as e:

        return {
            "ok": False,
            "error": str(e),
        }


